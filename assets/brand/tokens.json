{
  "project": {
    "name": "Abyss Tattoo Studio v3",
    "phase": "Hero 3D / dirección visual / motion",
    "version": 3
  },
  "direction": {
    "concept": "Brutalismo editorial + fotografía documental + lujo oscuro",
    "tone": ["dark", "cinematic", "authentic", "editorial", "premium"]
  },
  "palette": {
    "abyss_black": "#050505",
    "charcoal": "#161616",
    "bone": "#E8E4DD",
    "dark_gold": "#8A642B",
    "primary_gold": "#C49A50",
    "studio_green": "#596047"
  },
  "gold": {
    "treatment": "oro envejecido, ligeramente quemado",
    "usage": [
      "logo",
      "ABYSS",
      "línea de apertura",
      "CTA",
      "microdetalles editoriales",
      "reflejos controlados"
    ],
    "never": "amarillo brillante o efecto casino"
  },
  "photography_policy": {
    "priority": "fotografía real",
    "tattoo": {
      "immutable": true,
      "never": [
        "redibujar",
        "regenerar",
        "completar con IA",
        "alterar líneas",
        "cambiar tinta",
        "deformar",
        "reinterpretar"
      ]
    },
    "allowed_photo_editing": [
      "exposición",
      "brillo",
      "contraste",
      "profundidad",
      "grano",
      "color grading",
      "separación de planos",
      "máscaras",
      "parallax",
      "desenfoque ambiental",
      "iluminación ambiental"
    ]
  },
  "hero_3d": {
    "principle": "El tatuaje permanece real. La fotografía gana profundidad. El espacio cobra vida.",
    "style": "pseudo-3D / 2.5D cinematográfico",
    "layers": [
      "background",
      "studio_environment",
      "atmospheric_light",
      "photographic_subject",
      "foreground",
      "ABYSS_typography",
      "gold_graphics",
      "micro_atmosphere",
      "UI"
    ]
  },
  "hero_copy": {
    "brand": "ABYSS",
    "descriptor": "TATTOO STUDIO",
    "services": "TATTOO • PIERCING • ART",
    "manifesto": ["TU CUERPO.", "TU HISTORIA.", "TU RITUAL."],
    "cta": "RESERVA TU SESIÓN →"
  }
}
